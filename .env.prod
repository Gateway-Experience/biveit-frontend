# Production build settings: `vite build --mode prod` (scripts/deploy.sh) reads this file on top of .env. Committed on
# purpose -- every VITE_* value ends up in the public bundle anyway, so nothing here is a secret. Never put a real
# secret in a VITE_* variable.
# A server-only override can go in .env.prod.local (gitignored, loaded after this one).

# Where the backend's API is. Required: deploy.sh refuses to build without it.
VITE_API_BASE_URL=
# The public landing site (the biveit-landing repo). Visitors who aren't signed in are sent there from the app's home.
VITE_LANDING_URL=https://biveit.com
# Google sign-in (same client as the backend's GOOGLE_CLIENT_ID).
VITE_GOOGLE_CLIENT_ID=822949391658-8tlanceg4cdbit5qmb4v7smnrna1hkl9.apps.googleusercontent.com
VITE_APP_LANGUAGE=en
VITE_PROJECT_NAME=biveit
# PostHog: the project's public key and its region's ingestion host (see services/analytics).
VITE_POSTHOG_KEY=phc_x4gciKoeaCpzAEm4EWpAfwSXWruTNZLUDzHarzFB9bnR
VITE_POSTHOG_HOST=https://eu.i.posthog.com
VITE_CREATE_GUEST_ACCOUNT=false
VITE_PROMOTE_GUEST_ACCOUNT=false
