VITE_TEST=1
VITE_API_BASE_URL=http://localhost:3001/api
# The public landing page (the biveit-landing repo, biveit.com in production). Visitors who aren't signed in and
# open the app's home page are sent there.
VITE_LANDING_URL=http://localhost:4322
# Configure google client ID. See README.md for steps.
VITE_GOOGLE_CLIENT_ID=
# Configure i18n. Probably have to check translation mappings as well.
VITE_APP_LANGUAGE=en
# Identifies this app in shared services — attached to every posthog event as a super
# property, so one posthog project can serve several apps and still tell them apart.
VITE_PROJECT_NAME=biveit
# PostHog project API key (phc_...). Leave empty to disable analytics entirely — every function in
# services/analytics.ts becomes a no-op, so nothing else needs to change.
VITE_POSTHOG_KEY=
# PostHog ingestion host: https://us.i.posthog.com or https://eu.i.posthog.com (or your own reverse proxy).
VITE_POSTHOG_HOST=https://eu.i.posthog.com
# Whether to create guest account on visit.
VITE_CREATE_GUEST_ACCOUNT=false
# Whether to promote guest account when a user is created. Only effective when VITE_CREATE_GUEST_ACCOUNT=true.
VITE_PROMOTE_GUEST_ACCOUNT=false
